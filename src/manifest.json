{
  "manifest_version": 3,
  "name": "TikTrans · 抖音口播提取",
  "version": "0.1.35",
  "description": "在抖音页面一键提取口播：逐行转写、修改、打标签、跨视频筛选与导出。全部在本地浏览器完成。",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "TikTrans：打开侧边栏",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.douyin.com/*",
        "https://*.iesdouyin.com/*"
      ],
      "js": [
        "content/page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.douyin.com/*",
        "https://*.iesdouyin.com/*"
      ],
      "js": [
        "content/page-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": [
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "offscreen",
    "scripting",
    "contextMenus",
    "alarms",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://*.douyin.com/*",
    "https://*.iesdouyin.com/*",
    "https://*.douyinvod.com/*",
    "https://*.zjcdn.com/*",
    "https://*.bytecdn.com/*",
    "https://*/*",
    "http://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
